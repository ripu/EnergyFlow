#!/bin/sh
# --- EnergyFlow kiosk autostart (labwc/Wayland) ---
# Deploy: copiare in ~/.config/labwc/autostart sul Raspberry, chmod +x.
# Compositor: labwc sotto lightdm, autologin. Monitor: HDMI-A-1 (1920x1080).

OUTPUT=HDMI-A-1
TRANSFORM=270         # verticale, verso corretto per QUESTO montaggio a muro.
                      # Provato 90 il 2026-08-09: l'immagine esce capovolta. I due
                      # valori ruotano in versi opposti e quale sia giusto dipende da
                      # come il monitor e' appeso, non dal software: verificarlo
                      # guardando il pannello, non deducendolo.

# 1) Monitor in verticale — con attesa, non a fiducia.
#    La versione precedente lanciava wlr-randr subito: all'avvio della sessione
#    l'uscita HDMI spesso non e' ancora pronta, il comando falliva in silenzio e
#    il pannello restava orizzontale. Trovato dal vivo il 2026-08-09, con
#    l'autostart che diceva 270 e il monitor che era su "normal".
i=0
while [ $i -lt 30 ]; do
    if wlr-randr 2>/dev/null | grep -q "^$OUTPUT"; then
        wlr-randr --output "$OUTPUT" --transform "$TRANSFORM" 2>/dev/null
        # verifica: se non ha attecchito, riprova al giro dopo
        if wlr-randr 2>/dev/null | grep -A20 "^$OUTPUT" | grep -qi "Transform: $TRANSFORM"; then
            break
        fi
    fi
    i=$((i + 1))
    sleep 1
done

# 2) Dashboard a tutto schermo in kiosk.
#    URL locale: il pannello non dipende ne' dalla rete di casa ne' dal tailnet.
#    --password-store=basic e' obbligatorio: senza, chromium chiede "Choose password
#    for new keyring" (gnome-keyring) e non arriva mai a caricare la pagina.
#    Traduzione: il sistema è in en_GB, la dashboard è in italiano, e chromium
#    propone di tradurla con un riquadro in alto a destra — su un pannello a muro
#    resta lì per sempre perché nessuno lo chiude. `TranslateUI` da solo non basta
#    più: è il nome vecchio della funzionalità, da Chromium 120 circa si chiama
#    `Translate`. Si passano entrambi, e si dichiara la lingua dell'interfaccia
#    così il browser non considera la pagina "straniera".
( sleep 3; exec chromium \
    --kiosk \
    --password-store=basic \
    --app=http://localhost:8003/ \
    --lang=it-IT \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-translate \
    --disable-features=Translate,TranslateUI \
    --ozone-platform=wayland \
    --check-for-update-interval=31536000 ) &
